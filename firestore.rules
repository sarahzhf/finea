rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth guard function
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow create, read, update, delete: if isOwner(userId);
      
      // All subcollections under a user
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Global Public (to authenticated users) read-only collections
    match /quiz_questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; // Only via admin SDK or seed script
    }
  }
}
